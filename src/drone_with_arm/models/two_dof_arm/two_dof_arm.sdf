<sdf version='1.7'>
  <model name='two_dof_arm'>
    <link name='base_link'>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0.1 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
      </collision>
      <visual name='base_link_visual'>
        <pose>0 0 0.1 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
      </visual>
    </link>
    <joint name='joint1' type='revolute'>
      <pose relative_to='base_link'>0 0 0.2 0 -0 0</pose>
      <parent>base_link</parent>
      <child>link1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>10</effort>
          <velocity>3</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='link1'>
      <pose relative_to='joint1'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0 0 0.15 0 -0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <collision name='link1_collision'>
        <pose>0 0 0.15 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.3</length>
            <radius>0.03</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='link1_visual'>
        <pose>0 0 0.15 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.3</length>
            <radius>0.03</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name='joint2' type='revolute'>
      <pose relative_to='link1'>0 0 0.3 0 -0 0</pose>
      <parent>link1</parent>
      <child>link2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-2</lower>
          <upper>2</upper>
          <effort>10</effort>
          <velocity>3</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='link2'>
      <pose relative_to='joint2'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0 0 0.15 0 -0 0</pose>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.003</iyy>
          <iyz>0</iyz>
          <izz>0.003</izz>
        </inertia>
      </inertial>
      <collision name='link2_collision'>
        <pose>0 0 0.15 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.3</length>
            <radius>0.025</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='link2_visual'>
        <pose>0 0 0.15 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.3</length>
            <radius>0.025</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <static>0</static>
    <plugin name='gazebo_ros2_control' filename='libgazebo_ros2_control.so'>
      <parameters>/home/kristoffer/MAS_ws_public/install/drone_with_arm/share/drone_arm/config/controllers.yaml</parameters>
    </plugin>
  </model>
</sdf>
